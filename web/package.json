{
  "name": "breakout-rl-browser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-web-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "npm run prepare:assets",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy:preview": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@farama/ale-wasm": "0.12.0",
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  }
}
