 #include <sstream>
 #include <cstring>
 #include <optional>
@@ -264,6 +266,43 @@ void StellaEnvironment::setDifficulty(difficulty_t value) {
   m_state.setDifficulty(value);
 }
+
+void StellaEnvironment::setBreakoutPaddlePosition(float normalized_x) {
+  if (!m_use_paddles) {
+    throw std::runtime_error("setBreakoutPaddlePosition requires a paddle-based game");
+  }
+  if (std::strcmp(m_settings->rom(), "breakout") != 0) {
+    throw std::runtime_error("setBreakoutPaddlePosition requires Breakout");
+  }
+  if (!std::isfinite(normalized_x)) {
+    throw std::invalid_argument("paddle position must be finite");
+  }
+  const float target_x = std::clamp(normalized_x, 0.0f, 1.0f);
+  // Breakout's paddle potentiometer maps to visible X in the reverse direction.
+  const float normalized_resistance = std::clamp(
+      (1.2386905f - target_x) / 1.1454613f, 0.0f, 1.0f);
+  const int left = m_state.m_paddle_min + static_cast<int>(
+      std::lround(normalized_resistance * (m_state.m_paddle_max - m_state.m_paddle_min)));
+  m_state.setPaddles(m_osystem->event(), left, m_state.m_right_paddle);
+  // The pinned Breakout ROM stores the paddle's left and right scan positions
+  // in these RAM bytes. Reassert them per frame for direct Mouse positioning.
+  constexpr float kLeftPositionIntercept = 200.0f;
+  constexpr float kLeftPositionScale = 168.0f;
+  constexpr int kLeftPositionMin = 34;
+  constexpr int kLeftPositionMax = 184;
+  constexpr int kRightPositionIntercept = 39;
+  constexpr float kRightPositionScale = 160.0f;
+  constexpr int kRightPositionMin = 55;
+  constexpr int kRightPositionMax = 191;
+  constexpr int kLeftPositionRamAddress = 70;
+  constexpr int kRightPositionRamAddress = 72;
+  const int ram_left = std::clamp(static_cast<int>(std::lround(
+      kLeftPositionIntercept - kLeftPositionScale * target_x)), kLeftPositionMin, kLeftPositionMax);
+  const int ram_right = std::clamp(static_cast<int>(std::lround(
+      kRightPositionIntercept + kRightPositionScale * target_x)), kRightPositionMin, kRightPositionMax);
+  setRAM(kLeftPositionRamAddress, static_cast<byte_t>(ram_left));
+  setRAM(kRightPositionRamAddress, static_cast<byte_t>(ram_right));
+}
 
