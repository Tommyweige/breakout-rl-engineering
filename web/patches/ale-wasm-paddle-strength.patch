diff --git a/src/ale/environment/stella_environment.cpp b/src/ale/environment/stella_environment.cpp
--- a/src/ale/environment/stella_environment.cpp
+++ b/src/ale/environment/stella_environment.cpp
@@ -20,6 +20,8 @@
 #include "ale/environment/stella_environment.hpp"
 
 #include <algorithm>
